#!/usr/bin/env bash
# Resolve icon file paths for Hyprland window classes.
# Usage: get_dock_icons.sh class1 class2 ...
# Output: class|/absolute/path/to/icon.png  (one per line, empty path if not found)

resolve_icon() {
    local name="$1"
    [ -z "$name" ] && return
    [[ "$name" == /* ]] && [ -f "$name" ] && echo "$name" && return
    local dirs=(
        "$HOME/.local/share/icons/hicolor/48x48/apps"
        "$HOME/.local/share/icons/hicolor/scalable/apps"
        "/usr/share/icons/hicolor/48x48/apps"
        "/usr/share/icons/hicolor/scalable/apps"
        "/usr/share/icons/hicolor/256x256/apps"
        "/usr/share/icons/hicolor/128x128/apps"
        "/usr/share/icons/hicolor/64x64/apps"
        "/usr/share/pixmaps"
        "$HOME/.local/share/icons"
        "/var/lib/flatpak/exports/share/icons/hicolor/scalable/apps"
        "/var/lib/flatpak/exports/share/icons/hicolor/128x128/apps"
        "/var/lib/flatpak/exports/share/icons/hicolor/64x64/apps"
        "$HOME/.local/share/flatpak/exports/share/icons/hicolor/scalable/apps"
    )
    for d in "${dirs[@]}"; do
        [ -f "$d/$name.png" ] && echo "$d/$name.png" && return
        [ -f "$d/$name.svg" ] && echo "$d/$name.svg" && return
        [ -f "$d/$name.xpm" ] && echo "$d/$name.xpm" && return
    done
}

find_icon_for_class() {
    local cls="$1"
    local cls_lower="${cls,,}"

    # 1. Direct icon name match (class IS the icon name)
    local p
    p=$(resolve_icon "$cls");       [ -n "$p" ] && echo "$p" && return
    p=$(resolve_icon "$cls_lower"); [ -n "$p" ] && echo "$p" && return

    # 2. Desktop file with matching StartupWMClass (exact, then case-insensitive)
    local desktop
    desktop=$(grep -rl "^StartupWMClass=${cls}$" \
                /usr/share/applications \
                "$HOME/.local/share/applications" \
                /var/lib/flatpak/exports/share/applications \
                "$HOME/.local/share/flatpak/exports/share/applications" \
                2>/dev/null | head -1)
    [ -z "$desktop" ] && \
    desktop=$(grep -ril "^StartupWMClass=${cls}$" \
                /usr/share/applications \
                "$HOME/.local/share/applications" \
                2>/dev/null | head -1)

    # 3. Desktop file named after the class
    if [ -z "$desktop" ]; then
        for dir in /usr/share/applications "$HOME/.local/share/applications" \
                   /var/lib/flatpak/exports/share/applications; do
            [ -f "$dir/${cls}.desktop"       ] && desktop="$dir/${cls}.desktop"       && break
            [ -f "$dir/${cls_lower}.desktop" ] && desktop="$dir/${cls_lower}.desktop" && break
        done
    fi

    # 4. Desktop file whose Name= loosely matches
    if [ -z "$desktop" ]; then
        desktop=$(grep -ril "^Name=${cls}$" /usr/share/applications 2>/dev/null | head -1)
    fi

    if [ -n "$desktop" ]; then
        local icon_name
        icon_name=$(grep "^Icon=" "$desktop" 2>/dev/null | head -1 | cut -d= -f2-)
        [ -n "$icon_name" ] && p=$(resolve_icon "$icon_name") && [ -n "$p" ] && echo "$p" && return
    fi

    # 5. Deep search in installed icon themes (48px+ or scalable, prefer png over svg)
    local search_name="$cls_lower"
    p=$(find "$HOME/.local/share/icons" /usr/share/icons -path "*/apps/*" \
         \( -name "${search_name}.png" -o -name "${search_name}.svg" \) \
         2>/dev/null | grep -E "(48x48|64x64|256x256|scalable)" | head -1)
    [ -n "$p" ] && echo "$p" && return

    # 6. Anywhere in pixmaps / icons with any size
    p=$(find /usr/share/pixmaps "$HOME/.local/share/icons" /usr/share/icons \
         -name "${search_name}.png" -o -name "${search_name}.svg" \
         2>/dev/null | head -1)
    [ -n "$p" ] && echo "$p" && return
}

for cls in "$@"; do
    icon=$(find_icon_for_class "$cls")
    printf '%s|%s\n' "$cls" "$icon"
done
